# Firebase Web App configuration from Firebase Console > Project settings > Your apps.
# These are public client configuration values, not Firebase Admin secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API base URL. Leave empty when a development proxy serves the API.
VITE_API_URL=http://localhost:4000
