{
  "name": "legal-drafter-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Legal Drafter Pro Backend API",
  "main": "dist/server.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:db-push": "prisma db push",
    "dev": "prisma generate && ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:legacy": "prisma generate && npx ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "npm install --include=dev && prisma generate && npx tsc && node -e \"require('fs').existsSync('dist/server.js') || process.exit(1)\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "jest --passWithNoTests"
  },
  "nodemon": {
    "watch": [
      "src",
      "prisma/schema"
    ],
    "ext": "ts,json,prisma",
    "ignore": [
      "src/**/*.spec.ts",
      "dist"
    ],
    "exec": "prisma generate && ts-node src/server.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "@types/nodemailer": "^8.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.6.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.11.0",
    "multer": "^2.1.0",
    "nodemailer": "^10.0.0",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.3",
    "@types/pdf-parse": "^1.1.5",
    "nodemon": "^3.1.14",
    "prisma": "^6.4.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
