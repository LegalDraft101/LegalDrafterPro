# Server address and browser CORS allow-list. Use comma-separated origins.
PORT=4000
API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:5173
ALLOW_REQUESTS_WITHOUT_ORIGIN=false

# Request, upload, and abuse-protection limits.
REQUEST_BODY_LIMIT=50kb
GENERAL_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
OCR_MAX_FILE_SIZE_BYTES=15728640
OCR_IMAGE_MAX_FILE_SIZE_BYTES=10485760

# Enable only when diagnosing an issue; debug logs may contain extra context.
LOG_DEBUG_ENABLED=false

# Firebase Admin SDK: server only; never expose these values to the frontend.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Email OTP delivery. The existing Gmail OAuth provider is reused when EMAIL_PROVIDER=gmail.
EMAIL_PROVIDER=gmail
EMAIL_FROM=
EMAIL_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
