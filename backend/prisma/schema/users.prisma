model User {
  id            String   @id @default(uuid())
  firstName     String?  @map("first_name")
  lastName      String?  @map("last_name")
  displayName   String?  @map("display_name")
  name          String   @default("")
  email         String   @unique
  phone         String?  @unique
  googleId      String?  @unique @map("google_id")
  passwordHash  String?  @map("password_hash")
  passwordSalt  String?  @map("password_salt")
  tokenVersion  Int      @default(0) @map("token_version")
  avatar        String?
  jobTitle      String?  @map("job_title")
  accountStatus String   @default("Active") @map("account_status")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  preferences       UserPreferences?
  verification      UserVerification?
  addresses         UserAddress[]
  deliveryAddresses UserDeliveryAddress[]
  documents         Document[]
  orders            Order[]
  payments          PaymentTransaction[]

  @@map("users")
}

model UserPreferences {
  userId             String   @id @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language           String   @default("en")
  theme              String   @default("System")
  emailNotifications Boolean  @default(true) @map("email_notifications")
  marketingEmails    Boolean  @default(false) @map("marketing_emails")
  whatsappEnabled    Boolean  @default(false) @map("whatsapp_enabled")
  smsNotifications   Boolean  @default(false) @map("sms_notifications")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("user_preferences")
}

model UserVerification {
  userId               String    @id @map("user_id")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAuthenticated   Boolean   @default(false) @map("email_authenticated")
  emailAuthenticatedAt DateTime? @map("email_authenticated_at")
  phoneAuthenticated   Boolean   @default(false) @map("phone_authenticated")
  phoneAuthenticatedAt DateTime? @map("phone_authenticated_at")
  lastAuthenticationAt DateTime? @map("last_authentication_at")

  @@map("user_verification")
}

model UserAddress {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String
  state        String
  postalCode   String   @map("postal_code")
  country      String
  addressType  String   @map("address_type")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("user_addresses")
}

model UserDeliveryAddress {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  altPhone     String?  @map("alt_phone")
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String
  state        String
  pincode      String
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("user_delivery_addresses")
}
